      "PowerShell(node app/cli.mjs op run employers.sectors *)",
      "PowerShell(node app/cli.mjs op run evidence.list *)",
      "PowerShell(node app/cli.mjs op run evidence.strength *)",
      "PowerShell(node app/cli.mjs op run materials.list *)",
      "PowerShell(node app/cli.mjs op run materials.get *)",
      "PowerShell(node app/cli.mjs op run brief.get *)",
      "PowerShell(node app/cli.mjs op run rules.list *)",
      "PowerShell(node app/cli.mjs op run submissions.list *)",
      "PowerShell(node app/cli.mjs op run storage.report *)",
      "PowerShell(node app/cli.mjs op run backup.list *)",
      "PowerShell(node app/cli.mjs op run docs.check *)",
